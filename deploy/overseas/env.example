# ============================================================
# 鲸域后端环境变量模板 · 境外部署版
# 部署：sudo -u jingyu nano /var/www/jingyu/server/.env
#       sudo chmod 600 /var/www/jingyu/server/.env
#
# 与 server/.env.example 的差别：
#   - SITE_ORIGIN 必须是 https，否则 cookie 的 secure 标志不会开（server/src/auth.js:187）
#   - 去掉 COS 段：境外机器到广州 COS 的延迟不划算，先用本地 /uploads 兜住
#     （真要上对象存储，换 Cloudflare R2 / Backblaze B2，S3 协议通用）
#   - MEMBERSHIP_SANDBOX 必须是 0
# ============================================================

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# ---- 密钥 ----
# 生成：openssl rand -hex 32
JWT_SECRET=__JWT_SECRET__
SESSION_SECRET=__SESSION_SECRET__
JWT_EXPIRES=604800

# ---- 站点 ----
# 末尾不带斜杠。https 是硬要求：它同时决定 cookie 的 secure 标志和 OAuth 回调地址
SITE_ORIGIN=https://__DOMAIN__
ADMIN_PATH=/admin

# ---- 上传（无对象存储，落本地盘）----
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
UPLOAD_URL_TTL=300
UPLOAD_LOCAL_DIR=/var/www/jingyu/uploads

# ---- 数据库 ----
DB_PATH=/var/www/jingyu/server/data/jingyu.db

# ---- 会员赞助 ----
MEMBERSHIP_GOAL_CENTS=68000
# 生产必须 0：置 1 等于开放「任何人点一下就把订单改 paid」
MEMBERSHIP_SANDBOX=0
MEMBERSHIP_ORDER_TTL=1800
# 站外渠道（爱发电 / 收款码）订单有效期，默认 259200 = 3 天。
# 爱发电那边用户可能隔天才付款，30 分钟太短，过期订单只能重下。
MEMBERSHIP_OFFSITE_TTL=259200

# ---- 爱发电 ----
# 你的爱发电主页地址，例如 https://ifdian.net/a/yourname
# 填了它首页支付方式里「爱发电」才会是可选状态（live=true）；
# 留空则该渠道自动置灰，按钮不可点，不会出现点进去 404 的情况。
# 只接受 http/https，超长或乱填会被后端丢弃退回空串。
AFDIAN_URL=

# 人工收款码渠道开关：把 assets/pay/manual.png 放好之后才设 1。
# 留空/0 时「扫码转账」渠道置灰，避免页面渲染出一个空二维码框。
PAY_MANUAL_QR=0

# ---- 短信（境外机器发不了国内短信，保持 none；前端会自动隐藏手机号入口）----
SMS_PROVIDER=none
SMS_DEV=0

# ---- 第三方登录（没配就自动置灰，不会 500）----
OAUTH_QQ_CLIENT_ID=
OAUTH_QQ_CLIENT_SECRET=
OAUTH_WECHAT_CLIENT_ID=
OAUTH_WECHAT_CLIENT_SECRET=

LOG_LEVEL=info
