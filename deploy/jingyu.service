[Unit]
Description=Jingyu Community API
Documentation=https://github.com/your-repo/jingyu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jingyu
Group=jingyu
WorkingDirectory=/var/www/jingyu/server

# 环境变量从 .env 读取（COS 密钥、JWT secret、端口等）
# 文件权限必须是 600，属主 jingyu
EnvironmentFile=/var/www/jingyu/server/.env

ExecStart=/usr/bin/node src/index.js

# 崩溃自动重启，3 秒后重试
Restart=always
RestartSec=3

# 日志走 journald，用 journalctl -u jingyu -f 查看
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jingyu-api

# ---------- 安全加固 ----------
# 提权保护：进程无法通过 setuid 提权
NoNewPrivileges=true
# 私有 /tmp，与系统隔离
PrivateTmp=true
# 保护整个文件系统只读，只放开必要目录
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/jingyu
# 禁止访问内核相关
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# 禁止修改网络配置
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# WebSocket 长连接需要大量文件句柄
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
