# 鲸域 · 后端环境变量模板
#
# 使用方法：
#   sudo -u jingyu cp deploy/env.example /var/www/jingyu/server/.env
#   sudo -u jingyu nano /var/www/jingyu/server/.env
#   sudo chmod 600 /var/www/jingyu/server/.env
#
# 安全要求：这个文件含密钥，权限必须 600，绝不能提交到 git

# ---------- 服务 ----------
NODE_ENV=production
PORT=3000
# 只监听本机，由 Nginx 反代对外。改成 0.0.0.0 会让 3000 端口直接暴露公网
HOST=127.0.0.1

# ---------- 鉴权 ----------
# 生成方式：openssl rand -hex 32
JWT_SECRET=
# 同上，用于 cookie 签名
SESSION_SECRET=
# token 有效期（秒），7 天
JWT_EXPIRES=604800

# ---------- 腾讯云 COS ----------
# 控制台 → 访问管理 → API 密钥管理
COS_SECRET_ID=
COS_SECRET_KEY=
# 存储桶名，格式 名称-APPID
COS_BUCKET=
# 必须与服务器同地域（上海 = ap-shanghai），否则内网不通、走公网流量费
COS_REGION=ap-shanghai
# CDN 加速域名，末尾不要带斜杠
COS_CDN_DOMAIN=https://img.example.com

# ---------- 上传限制 ----------
# 5 MB
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
# 预签名 URL 有效期（秒）
UPLOAD_URL_TTL=300

# ---------- 数据库 ----------
# SQLite 文件路径，放在 server/data 下，随应用一起备份
DB_PATH=/var/www/jingyu/server/data/jingyu.db

# ---------- 站点 ----------
# 前端域名，用于 CORS 白名单和 cookie domain
SITE_ORIGIN=https://www.example.com
# 管理后台路径（如有）
ADMIN_PATH=/admin
