# ============================================================
# 鲸域后端环境变量模板
# 部署时复制为 .env 并填真实值：cp .env.example .env && chmod 600 .env
# ============================================================

# 运行模式；生产必须是 production
NODE_ENV=production

# 监听地址：只绑本机，公网一律经 Nginx 反代
PORT=3000
HOST=127.0.0.1

# JWT 签名密钥；生成：openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=
# 登录有效期（秒），默认 7 天
JWT_EXPIRES=604800

# ---- 腾讯云 COS（图片直传用；缺失时后端自动降级为本地存储）----
COS_SECRET_ID=
COS_SECRET_KEY=
# 存储桶，格式：名称-APPID，例如 jingyu-1300000000
COS_BUCKET=
# 地域，必须与服务器同区，广州的机器就写 ap-guangzhou
COS_REGION=ap-guangzhou
# 图片访问域名（CDN 或 COS 默认域名），末尾不带斜杠
COS_CDN_DOMAIN=

# ---- 上传限制 ----
# 5MB 上限，超过直接拒绝
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
# 预签名 URL 有效期（秒）
UPLOAD_URL_TTL=300
# 无 COS 时本地落盘目录
UPLOAD_LOCAL_DIR=/var/www/jingyu/uploads

# ---- 数据库 ----
DB_PATH=/var/www/jingyu/server/data/jingyu.db

# ---- 站点 ----
SITE_ORIGIN=http://43.142.153.74
ADMIN_PATH=/admin

# ---- 短信通道（手机号认证 / 登录验证码）----
# provider 三选一：tencent（腾讯云）/ aliyun（阿里云）/ webhook（云片、容联、SUBMAIL、自建网关）
# 留空 = 未接通：前端会如实显示「短信通道还没接通」，认证页给「跳过」出口，不拦人
# dev = 不发真短信，验证码回显在响应与日志里（只在本机/CI 用，生产必须换掉）
SMS_PROVIDER=
SMS_REGION=ap-guangzhou

# 腾讯云：短信控制台 → 应用管理 拿 SdkAppId；签名管理 / 正文模板管理审核通过后拿 SignName / TemplateId
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=

# 阿里云：AccessKey 建议用 RAM 子账号（只授 AliyunDysmsFullAccess），签名/模板在短信控制台审核后取
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_TEMPLATE_CODE=

# webhook 网关：POST JSON {phone, code, ttl, scene}；2xx 视为受理
# 带 X-SMS-Sign（HMAC-SHA256(rawBody, SMS_WEBHOOK_SECRET)）与可选 Bearer Token
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
SMS_WEBHOOK_TOKEN=

# ---- 会员赞助 ----
# 本月筹款目标（分）；68000 = ¥680.00。后台改 member_settings.monthly_goal_cents 可覆盖
MEMBERSHIP_GOAL_CENTS=68000
# 沙箱支付开关：1=允许 POST /api/membership/orders/:no/simulate 直接置 paid（本地演示用）
# 生产环境务必设 0，并给真实支付渠道配好密钥，否则任何人都能免费开通会员
MEMBERSHIP_SANDBOX=1
# 订单支付有效期（秒），默认 1800 = 30 分钟；超时后订单只能关闭，不能补付
MEMBERSHIP_ORDER_TTL=1800
# 站外渠道（爱发电 / 收款码）订单有效期（秒），默认 259200 = 3 天。
# 爱发电那边用户常常隔天才付款，30 分钟太短，过期就只能重新下单。
MEMBERSHIP_OFFSITE_TTL=259200
# 爱发电主页地址，例如 https://ifdian.net/a/yourname
# 留空则「爱发电」渠道自动置灰（live=false），前端按钮不可点。
AFDIAN_URL=
# 人工收款码渠道开关：assets/pay/manual.png 放好之后再设 1，否则渠道置灰
PAY_MANUAL_QR=0

# 日志级别：fatal/error/warn/info/debug/trace
LOG_LEVEL=info
