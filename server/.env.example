# ============================================================
# 鲸域后端环境变量模板
# 部署时复制为 .env 并填真实值：cp .env.example .env && chmod 600 .env
# ============================================================

# 运行模式；生产必须是 production
NODE_ENV=production

# 监听地址：只绑本机，公网一律经 Nginx 反代
PORT=3000
HOST=127.0.0.1

# JWT 签名密钥；生成：openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=
# 登录有效期（秒），默认 7 天
JWT_EXPIRES=604800

# ---- 腾讯云 COS（图片直传用；缺失时后端自动降级为本地存储）----
COS_SECRET_ID=
COS_SECRET_KEY=
# 存储桶，格式：名称-APPID，例如 jingyu-1300000000
COS_BUCKET=
# 地域，必须与服务器同区，广州的机器就写 ap-guangzhou
COS_REGION=ap-guangzhou
# 图片访问域名（CDN 或 COS 默认域名），末尾不带斜杠
COS_CDN_DOMAIN=

# ---- 上传限制 ----
# 5MB 上限，超过直接拒绝
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
# 预签名 URL 有效期（秒）
UPLOAD_URL_TTL=300
# 无 COS 时本地落盘目录
UPLOAD_LOCAL_DIR=/var/www/jingyu/uploads

# ---- 短信通道（手机号认证）----
# SMS_DEV=1 时 /api/auth/phone/send 会在响应里回显 devCode；线上必须留空或设 0
SMS_DEV=
# aliyun | tencent
SMS_PROVIDER=
# 只用子账号 AK，别用主账号；权限只给短信
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 短信签名（服务商后台审核通过的名称）
SMS_SIGN_NAME=
# 验证码模板编号，模板内容须含 ${code} 变量
SMS_TEMPLATE_CODE=

# ---- 第三方登录（三家都是「有 Client ID 与 Secret 才启用」，缺则回 501 不报 500）----
# QQ 互联 AppID / AppKey；回调需在 connect.qq.com 后台登记
OAUTH_QQ_CLIENT_ID=
OAUTH_QQ_CLIENT_SECRET=
# 回调地址可整串覆盖，不填默认 ${SITE_ORIGIN}/api/auth/oauth/qq/callback
OAUTH_QQ_CALLBACK=
# 微信开放平台 AppID / AppSecret；后台「授权回调域」只填域名，不带协议与路径
OAUTH_WECHAT_CLIENT_ID=
OAUTH_WECHAT_CLIENT_SECRET=
OAUTH_WECHAT_CALLBACK=
# GitHub OAuth App Client ID / Secret；Authorization callback URL 必须与之一致
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CALLBACK=

# ---- 数据库 ----
DB_PATH=/var/www/jingyu/server/data/jingyu.db

# ---- 站点 ----
SITE_ORIGIN=http://43.142.153.74
ADMIN_PATH=/admin

# 日志级别：fatal/error/warn/info/debug/trace
LOG_LEVEL=info
